# Copy this file to .env and adjust the values for your environment.

# Django settings
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database settings
DB_NAME=my_financial_db
DB_USER=my_financial_user
DB_PASSWORD=my_financial_password
DB_HOST=db
DB_PORT=5432

# Optional SQLAlchemy connection string for tools that use it
SQLALCHEMY_DATABASE_URI=postgresql://my_financial_user:my_financial_password@db:5432/my_financial_db

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Superset settings
SUPERSET_SECRET_KEY=change-me
SUPERSET_SQLALCHEMY_DATABASE_URI=sqlite:////app/superset.db

# PostgreSQL container variables used by docker-compose
POSTGRES_DB=my_financial_db
POSTGRES_USER=my_financial_user
POSTGRES_PASSWORD=my_financial_password
